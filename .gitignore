__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Data and large files
*.pth
*.xlsx

# Media (Graphs like .png are NOT ignored so they can be uploaded)
*.jpg
*.webp
*.webm
*.jpeg

